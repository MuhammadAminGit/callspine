# Retell: the API key carrying the webhook badge in the Retell dashboard.
RETELL_API_KEY=

# Vapi: must mirror the credential you created in Vapi. Vapi publishes no defaults for
# HMAC, so a mismatch fails closed on every request.
VAPI_MODE=hmac                     # hmac | shared_secret
VAPI_SECRET=
VAPI_SIGNATURE_HEADER=x-signature
VAPI_TIMESTAMP_HEADER=             # optional; set it (e.g. x-timestamp) for replay protection
VAPI_PAYLOAD_FORMAT={body}         # {body} | {timestamp}.{body}

# Bearer token for /api/*, which exposes transcripts and phone numbers.
# Leave empty and the read API is disabled.
CALLSPINE_API_TOKEN=

CALLSPINE_DB=callspine.db
