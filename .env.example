# Retell: the API key carrying the webhook badge in the dashboard.
RETELL_API_KEY=

# Vapi: these must match the credential you created in Vapi, because Vapi lets you
# define the scheme. A mismatch fails closed on every request.
VAPI_SECRET=
VAPI_MODE=hmac                          # hmac | shared_secret
VAPI_SIGNATURE_HEADER=x-vapi-signature
VAPI_TIMESTAMP_HEADER=x-timestamp
VAPI_PAYLOAD_FORMAT={timestamp}.{body}  # {timestamp}.{body} | {body}

CALLSPINE_DB=callspine.db
